{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "^0.18.4"
    }
  },
  "scripts": {
    "lint": "biome lint",
    "format": "biome check --write --linter-enabled=false",
    "test": "bun test",
    "build": "bun run --filter='./packages/**' build",
    "bump": "bunx changeset && bunx changeset version && bun update --lockfile-only'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/cli": "^2.29.8",
    "@typescript/native-preview": "^7.0.0-dev.20260117.1",
    "typescript": "^5.9.3"
  }
}
