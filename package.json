{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "tsdown": "^0.18.4"
    }
  },
  "scripts": {
    "lint": "bunx biome lint",
    "format": "bunx biome check --write --linter-enabled=false",
    "test": "bun test",
    "build": "bun run --filter='./packages/**' --elide-lines 0 build",
    "bump": "bunx changeset && bunx changeset version && bun update --lockfile-only'",
    "release": "bun run --filter='./packages/**' --elide-lines 0 npm:publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/cli": "^2.29.8",
    "@typescript/native-preview": "^7.0.0-dev.20251231.1",
    "typescript": "^5.9.3"
  }
}
