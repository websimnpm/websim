{
  "name": "websim",
  "version": "0.0.11",
  "description": "A TypeScript wrapper for the Websim.com API",
  "type": "module",
  "author": "gameroman",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/websimnpm/websim.git",
    "directory": "packages/websim"
  },
  "keywords": [
    "websim",
    "api",
    "typescript"
  ],
  "scripts": {
    "build": "bunx --bun tsdown",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@websimai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
