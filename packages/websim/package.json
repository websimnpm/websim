{
  "name": "websim",
  "version": "0.1.0",
  "description": "A TypeScript wrapper for the websim.com API",
  "keywords": [
    "api",
    "typescript",
    "websim"
  ],
  "license": "MIT",
  "author": "gameroman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websimnpm/websim.git",
    "directory": "packages/websim"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "imports": {
    "#api": "./src/api/index.ts",
    "#types/utils": "./src/types/utils.ts",
    "#types/projects": "./src/types/projects.ts",
    "#client/*": "./src/client/*/index.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@websimai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.22.9"
  }
}
